<UserControl x:Class="LocalAiPerf.App.Views.RuntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalAiPerf.App.Controls"
             xmlns:local="clr-namespace:LocalAiPerf.App">
  <UserControl.Resources>
    <local:StatusBrushConverter x:Key="StatusBrush" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
    <DataTemplate x:Key="ValueRows">
      <DataGrid ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="항목" Binding="{Binding Name, Mode=OneWay}" Width="150" />
          <DataGridTemplateColumn Header="값" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Value}" Style="{StaticResource WrapCell}" /></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="출처" Binding="{Binding Origin, Mode=OneWay}" Width="70" />
          <DataGridTemplateColumn Header="비고" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding Note}" Style="{StaticResource WrapCell}" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="AI 런타임" Style="{StaticResource PageTitle}" />

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
          <TextBlock Text="연결 대상" Style="{StaticResource Label}" />
          <TextBlock Grid.Column="1" Text="{Binding Endpoint, StringFormat='Strata · {0} (읽기 전용 GET만 사용)'}" Style="{StaticResource Value}" />
          <Button Grid.Column="2" Grid.RowSpan="2" Content="다시 연결" Command="{Binding ReconnectCommand}" Padding="14,4" VerticalAlignment="Top" />
          <TextBlock Grid.Row="1" Text="상태" Style="{StaticResource Label}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding StateLevel, Converter={StaticResource StatusBrush}}" />
            <TextBlock Text="{Binding StateText}" Style="{StaticResource Value}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ErrorCategory, StringFormat=' · 분류: {0}'}" Style="{StaticResource Value}"
                       Visibility="{Binding ErrorCategory, Converter={StaticResource NotEmpty}}" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="내용" Style="{StaticResource Label}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ErrorMessage}" Style="{StaticResource Value}" Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />
          <TextBlock Grid.Row="3" Text="안내" Style="{StaticResource Label}" Visibility="{Binding ErrorHint, Converter={StaticResource NotEmpty}}" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ErrorHint}" Style="{StaticResource Value}" Visibility="{Binding ErrorHint, Converter={StaticResource NotEmpty}}" />
          <TextBlock Grid.Row="4" Text="마지막 성공" Style="{StaticResource Label}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}">
            <Run Text="{Binding LastSuccess, Mode=OneWay}" /> <Run Text="{Binding NextRetry, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
          </TextBlock>
          <TextBlock Grid.Row="5" Text="인증" Style="{StaticResource Label}" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding KeyStatus}" Style="{StaticResource Value}" />
          <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource Caption}" Margin="0,6,0,0"
                     Text="연결 오류(실행 안 됨·포트 다름·시간 초과)와 API 호환성 오류(Strata 업데이트 등으로 응답 형식이 바뀜)를 구분해 표시합니다. 이 앱은 Strata 설정·파일·프로세스를 바꾸지 않으며, 프롬프트와 응답 내용은 조회하지 않습니다." />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="지금 측정" Command="{Binding RunBenchmarkCommand}" Padding="14,4" VerticalAlignment="Top" />
            <TextBlock Text="추론 측정 (공개 채팅 API로 고정 시험 문장 전송)" Style="{StaticResource SectionTitle}" />
          </DockPanel>
          <TextBlock Text="{Binding BenchmarkTarget}" Style="{StaticResource Value}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding BenchmarkKeyStatus}" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding BenchmarkAuto}" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding BenchmarkStatus}" Style="{StaticResource Value}" FontWeight="SemiBold" Margin="0,6,0,0"
                     Visibility="{Binding BenchmarkStatus, Converter={StaticResource NotEmpty}}" />
          <TextBlock Text="{Binding BenchmarkHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                     Visibility="{Binding BenchmarkHint, Converter={StaticResource NotEmpty}}" />
          <Border MinHeight="240" Margin="0,8,0,0">
            <c:ChartView Model="{Binding BenchmarkChart}" />
          </Border>
          <DataGrid ItemsSource="{Binding Benchmarks}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" MaxHeight="320">
            <DataGrid.Columns>
              <DataGridTextColumn Header="시각" Binding="{Binding Time, Mode=OneWay}" Width="150" />
              <DataGridTextColumn Header="모델" Binding="{Binding Model, Mode=OneWay}" Width="120" />
              <DataGridTextColumn Header="첫 토큰 (앱 측정)" Binding="{Binding FirstToken, Mode=OneWay}" Width="110" />
              <DataGridTextColumn Header="생성 속도 (앱 측정·계산값)" Binding="{Binding ClientDecode, Mode=OneWay}" Width="150" />
              <DataGridTextColumn Header="생성 속도 (엔진 보고)" Binding="{Binding EngineDecode, Mode=OneWay}" Width="130" />
              <DataGridTextColumn Header="프롬프트 처리 (엔진 보고)" Binding="{Binding EnginePrompt, Mode=OneWay}" Width="140" />
              <DataGridTextColumn Header="입력 / 출력 토큰" Binding="{Binding Tokens, Mode=OneWay}" Width="120" />
              <DataGridTextColumn Header="전체 시간" Binding="{Binding Total, Mode=OneWay}" Width="80" />
              <DataGridTemplateColumn Header="결과" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Result}" Style="{StaticResource WrapCell}" /></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                     Text="실제 대화의 속도는 위 텔레메트리(실시간 값)로 봅니다. 이 측정은 같은 시험 문장을 반복해 업데이트·설정 변경 전후를 같은 조건으로 비교하는 용도입니다. 응답 내용은 저장하지 않습니다. 같은 문장을 반복하면 프롬프트 캐시가 쓰여 프롬프트 처리 속도는 첫 회와 이후 회차가 다를 수 있습니다." />
        </StackPanel>
      </Border>

      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="서버" Style="{StaticResource SectionTitle}" />
            <ContentControl Content="{Binding Server}" ContentTemplate="{StaticResource ValueRows}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="모델" Style="{StaticResource SectionTitle}" />
            <ContentControl Content="{Binding Model}" ContentTemplate="{StaticResource ValueRows}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="실시간 추론 성능" Style="{StaticResource SectionTitle}" />
            <ContentControl Content="{Binding Live}" ContentTemplate="{StaticResource ValueRows}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" MinHeight="260">
          <c:ChartView Model="{Binding ThroughputChart}" />
        </Border>
      </UniformGrid>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="모델 기본 생성 설정 (/props)" Style="{StaticResource SectionTitle}" />
            <ContentControl Content="{Binding Settings}" ContentTemplate="{StaticResource ValueRows}" />
            <TextBlock Text="Strata가 API 키를 요구하고 읽기 전용 텔레메트리 키만 있으면 이 표는 비어 있을 수 있습니다." Style="{StaticResource Caption}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="슬롯별 컨텍스트" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding Slots}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="슬롯" Binding="{Binding Slot, Mode=OneWay}" Width="50" />
                <DataGridTextColumn Header="상태" Binding="{Binding State, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="보유 토큰" Binding="{Binding Held, Mode=OneWay}" Width="100" />
                <DataGridTextColumn Header="컨텍스트 사용 (계산값)" Binding="{Binding Fill, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="tok/s" Binding="{Binding TokS, Mode=OneWay}" Width="70" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="최근 완료 요청 (내용 없이 수치만)" Style="{StaticResource SectionTitle}" />
          <DataGrid ItemsSource="{Binding Recent}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0" MaxHeight="320">
            <DataGrid.Columns>
              <DataGridTextColumn Header="시작" Binding="{Binding Time, Mode=OneWay}" Width="150" />
              <DataGridTextColumn Header="처리 시간" Binding="{Binding Duration, Mode=OneWay}" Width="80" />
              <DataGridTextColumn Header="종료" Binding="{Binding Finish, Mode=OneWay}" Width="70" />
              <DataGridTextColumn Header="프롬프트 토큰" Binding="{Binding PromptTokens, Mode=OneWay}" Width="100" />
              <DataGridTextColumn Header="캐시 재사용" Binding="{Binding Reused, Mode=OneWay}" Width="90" />
              <DataGridTextColumn Header="출력 토큰" Binding="{Binding OutputTokens, Mode=OneWay}" Width="80" />
              <DataGridTextColumn Header="프롬프트 ms" Binding="{Binding PrefillMs, Mode=OneWay}" Width="90" />
              <DataGridTextColumn Header="디코드 ms" Binding="{Binding DecodeMs, Mode=OneWay}" Width="90" />
              <DataGridTextColumn Header="디코드 tok/s (계산값)" Binding="{Binding DecodeTokS, Mode=OneWay}" Width="140" />
              <DataGridTextColumn Header="첫 토큰 (엔진 기준)" Binding="{Binding FirstToken, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="요청 활동 (오류·시간 초과 포함, 익명 요청 ID)" Style="{StaticResource SectionTitle}" />
          <DataGrid ItemsSource="{Binding Activity}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0" Margin="0,4,0,0" MaxHeight="260">
            <DataGrid.Columns>
              <DataGridTextColumn Header="시각" Binding="{Binding Time, Mode=OneWay}" Width="160" />
              <DataGridTextColumn Header="요청 ID" Binding="{Binding RequestId, Mode=OneWay}" Width="130" />
              <DataGridTextColumn Header="이벤트" Binding="{Binding Event, Mode=OneWay}" Width="120" />
              <DataGridTextColumn Header="결과" Binding="{Binding Outcome, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
