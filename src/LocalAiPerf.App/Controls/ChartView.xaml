<UserControl x:Class="LocalAiPerf.App.Controls.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             MinHeight="160">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="2,0,2,4">
      <TextBlock x:Name="TitleText" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
      <TextBlock x:Name="UnitText" Style="{StaticResource Caption}" Margin="6,1,0,0" DockPanel.Dock="Left" />
      <TextBlock x:Name="Readout" Style="{StaticResource Caption}" HorizontalAlignment="Right" TextAlignment="Right"
                 Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <sp:WpfPlot x:Name="Plot" Grid.Row="1" MouseMove="OnPlotMouseMove" MouseLeave="OnPlotMouseLeave" />
    <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Caption}" HorizontalAlignment="Center"
               VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
  </Grid>
</UserControl>
